# NagarMitra — Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Flask secret key for session signing and CSRF protection.
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Configuration mode: development, testing, or production
FLASK_CONFIG=development

# Database URL (default: SQLite file in project root)
# DATABASE_URL=sqlite:///nagarmitra.db
